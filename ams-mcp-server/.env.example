# Path to the as_run executable INSIDE the environment this script runs in.
# If Code_Aster only exists inside Docker, you must either:
#   (a) run this whole project inside that same container, or
#   (b) change runner.py's subprocess call to `docker exec <container> as_run ...`
CODE_ASTER_PATH=/opt/aster/bin/as_run

# Optional — only needed for split setups (Python on host, Code_Aster in Docker).
# Lets `python -m src.check_environment` verify the container and solver path.
DOCKER_CONTAINER_NAME=code-aster-container
# DOCKER_WORKSPACE=/data/ams-mcp-server
# DOCKER_WORKSPACE_HOST=C:\Users\ADMIN\Downloads\ams-mcp-server\ams-mcp-server

OUTPUT_DIR=./outputs
LOG_LEVEL=INFO
DEFAULT_YIELD_STRENGTH_MPA=235.0

# MCP server (HTTP + Cloudflare connector)
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_TRANSPORT=streamable-http
# MCP_TRANSPORT=stdio   # use for local Claude spawn (no tunnel)
