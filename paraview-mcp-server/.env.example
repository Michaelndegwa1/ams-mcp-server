OUTPUT_DIR=./outputs
RENDER_DIR=./renders
LOG_LEVEL=INFO

# ParaView batch Python (set after installing ParaView)
# Example: C:\Program Files\ParaView 5.12.0\bin\pvpython.exe
PVPYTHON_PATH=

# auto | paraview | matplotlib
RENDER_BACKEND=auto

MCP_HOST=0.0.0.0
MCP_PORT=8768
MCP_TRANSPORT=streamable-http
