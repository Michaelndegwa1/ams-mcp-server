DEBUT(LANG='EN')

mesh = LIRE_MAILLAGE(UNITE=21, FORMAT='MED')

model = AFFE_MODELE(MAILLAGE=mesh,
                     AFFE=_F(TOUT='OUI', PHENOMENE='MECANIQUE', MODELISATION='3D'))

steel = DEFI_MATERIAU(ELAS=_F(E=71700.0, NU=0.33))
mat = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(TOUT='OUI', MATER=steel))

bc = AFFE_CHAR_MECA(MODELE=model,
                    DDL_IMPO=(
             _F(GROUP_MA='FACE_INF', DX=0.0, DY=0.0, DZ=0.0)
                    ))

load = AFFE_CHAR_MECA(MODELE=model,
                      FORCE_FACE=(
               _F(GROUP_MA='FACE_SUP', FZ=11.992228352645695)
                      ))

res = MECA_STATIQUE(MODELE=model,
                     CHAM_MATER=mat,
                     EXCIT=(_F(CHARGE=bc), _F(CHARGE=load)))

IMPR_RESU(FORMAT='MED', UNITE=80,
          RESU=_F(RESULTAT=res, NOM_CHAM=('DEPL', 'SIEF_ELGA')))

FIN()